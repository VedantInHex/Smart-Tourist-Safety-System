# Database (optional; omit to use the local mock database)
# DB_HOST=
# DB_USER=
# DB_PASS=
# DB_NAME=
# DB_PORT=5432

# Authentication
# JWT_SECRET=replace-with-a-long-random-secret

# Direct HTTPS mode. Use this only when Node terminates TLS itself.
# HTTPS_ENABLED=true
# HTTPS_PORT=443
# Paths are resolved relative to server/.
# HTTPS_KEY_PATH=./certs/privkey.pem
# HTTPS_CERT_PATH=./certs/fullchain.pem
